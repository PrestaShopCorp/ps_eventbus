{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block stylesheets %}
  {{ parent() }}

  {% if not LIVE_MODE_VUEJS %}
    {% if eventbus_preload_urls is defined %}
      {% for p in eventbus_preload_urls %}
        {% if p.rel == 'preload' and p.as == 'style' %}
          <link rel="preload" as="style" href="{{ p.href }}">
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if eventbus_css_url is defined and eventbus_css_url %}
      <link rel="stylesheet" href="{{ eventbus_css_url }}" type="text/css" media="all">
    {% endif %}
  {% endif %}
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  {% if LIVE_MODE_VUEJS %}
    <script type="module" src="http://localhost:5173/@vite/client"></script>
    <script type="module" src="http://localhost:5173/js/main.js"></script>
  {% else %}
    {% if eventbus_preload_urls is defined %}
      {% for p in eventbus_preload_urls %}
        {% if p.rel == 'modulepreload' %}
          <link rel="modulepreload" href="{{ p.href }}">
        {% endif %}
      {% endfor %}
    {% endif %}

    <script type="module" src="{{ eventbus_js_url }}"></script>
  {% endif %}
{% endblock %}

{% block content %}
  <div id="vue-app"></div>
{% endblock %}
